{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "allowJs": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "tools/**/*.js",
    "electron/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "_reference",
    "release"
  ]
}
